# Conexion a PostgreSQL (Neon o local). Usar URL JDBC.
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce-ropa
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Puerto del servidor
PORT=8080

# Seguridad
JWT_SECRET=clave-secreta-cambiar-en-produccion
JWT_EXPIRES_IN=24h

# Frontend (si esta definido, CORS queda restringido a ese origen; si no, CORS abierto)
FRONTEND_URL=http://localhost:5173

# URL publica del backend (se usa para construir URLs de imagenes locales)
API_URL=http://localhost:8080

# WhatsApp de contacto
WHATSAPP_NUMBER=

# Cloudinary (opcional: si se setean las 3, sube a Cloudinary; si no, usa storage local en uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
